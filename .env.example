# =============================================================================
# BRIEFEN — FRONTEND (Next.js) ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to `.env.local` for local development.
# For production (Vercel), set these in the Vercel Project Settings → Environment Variables.
#
# NEXT_PUBLIC_* variables are embedded into the browser bundle at build time.
# Non-public variables are only available server-side.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. BACKEND API URLS [REQUIRED]
# Production:  https://your-api.onrender.com/api/v1
# Local Dev:   http://localhost:8000/api/v1
# Docker:      http://localhost:8000/api/v1  (browser always resolves via localhost)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# WebSocket URL for real-time meeting processing updates
# Production:  wss://your-api.onrender.com/ws
# Local Dev:   ws://localhost:8000/ws
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws


# -----------------------------------------------------------------------------
# 2. GOOGLE OAUTH [REQUIRED for Google Sign-In]
# Must match the Client ID configured at: https://console.cloud.google.com
# Ensure your Vercel/Render/localhost URLs are in "Authorised JavaScript origins"
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=


# -----------------------------------------------------------------------------
# 3. FEATURE FLAGS
# Set to "true" to bypass email verification in dev/Docker environments.
# MUST be "false" or unset in production.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SKIP_EMAIL_VERIFICATION=false


# =============================================================================
# DOCKER COMPOSE ONLY — Variables below are used by docker-compose.yml
# and the frontend Dockerfile build args. Not needed for Vercel deployment.
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass
POSTGRES_DB=briefen_db
