# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Node.js dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js build output
/.next/
/out/
/build

# Misc
.DS_Store
*.pem

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# =============================================================================
# SECURITY: Environment files — NEVER commit real secrets
# =============================================================================
# Root and frontend env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production

# Backend env files
backend/.env
backend/.env.local
backend/.env.production

# Docker Compose secrets file
docker.env

# NOTE: .env.example files ARE intentionally committed — they are safe templates.
# =============================================================================

# Vercel
.vercel

# TypeScript build info
*.tsbuildinfo
next-env.d.ts

# Python artifacts
backend/__pycache__/
backend/**/__pycache__/
backend/*.pyc
backend/**/*.pyc
backend/.pytest_cache/
backend/scratch/
backend/data/

# Local uploads (production uses Cloudinary)
backend/uploads/
