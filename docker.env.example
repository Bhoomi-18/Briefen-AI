# =============================================================================
# BRIEFEN — DOCKER COMPOSE ENVIRONMENT FILE
# =============================================================================
# Copy this file to `docker.env` and fill in your credentials.
# Used by docker-compose.yml for local development with all services containerised.
#
# NEVER commit docker.env — it contains real secrets.
# =============================================================================

APP_NAME="Briefen API"
APP_ENV=docker
DEBUG=true
API_V1_STR=/api/v1
PORT=8000

# JWT (change these for any multi-developer shared environment)
JWT_SECRET_KEY=dev_jwt_secret_key_change_in_production
JWT_REFRESH_SECRET_KEY=dev_jwt_refresh_secret_key_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# PostgreSQL (Docker service named "postgres")
DATABASE_URL=postgresql+asyncpg://postgres:postgres_secure_pass@postgres:5432/briefen_db

# Redis (Docker service named "redis")
REDIS_URL=redis://redis:6379/0

# Qdrant (Docker service named "qdrant")
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# Frontend URL (browser accesses localhost, not Docker service name)
FRONTEND_URL=http://localhost:3000
ADDITIONAL_CORS_ORIGINS=

# Google OAuth (optional for local dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini AI (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Storage (use "local" for Docker; "cloudinary" requires credentials)
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=52428800
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (leave blank to simulate email in logs)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER="Briefen <noreply@briefen.ai>"
SKIP_EMAIL_VERIFICATION=true

# Whisper model (base is a good balance for local dev)
WHISPER_MODEL_SIZE=base

# Celery worker concurrency
CELERY_CONCURRENCY=2

# PostgreSQL container config (used by the postgres service in docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass
POSTGRES_DB=briefen_db
