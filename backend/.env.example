# =============================================================================
# BRIEFEN — BACKEND ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to `.env` for local development, or set these as environment
# variables in your Render dashboard for production deployment.
#
# REQUIRED fields are marked with [REQUIRED] — the API will fail to start
# in production if these are not set.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. CORE APPLICATION
# -----------------------------------------------------------------------------
APP_NAME="Briefen API"

# Environment mode: development | docker | production
# Controls logging format, CORS policy, docs visibility, and startup validation.
APP_ENV=development

DEBUG=true
API_V1_STR=/api/v1

# Runtime port — Render injects $PORT automatically. Leave as 8000 locally.
PORT=8000


# -----------------------------------------------------------------------------
# 2. SECURITY — JWT Tokens [REQUIRED in production]
# Generate secure keys: openssl rand -hex 32
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_USE_openssl_rand_hex_32
JWT_REFRESH_SECRET_KEY=CHANGE_ME_USE_openssl_rand_hex_32_REFRESH
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256


# -----------------------------------------------------------------------------
# 3. DATABASE — PostgreSQL [REQUIRED]
# Production: Use your Neon connection string (postgresql+asyncpg://...)
# Local Dev:  postgresql+asyncpg://postgres:password@localhost:5432/briefen_db
# Docker:     postgresql+asyncpg://postgres:password@postgres:5432/briefen_db
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres_secure_pass@localhost:5432/briefen_db


# -----------------------------------------------------------------------------
# 4. REDIS — Cache & Celery Broker [REQUIRED]
# Production: Use your Upstash Redis URL (rediss://...)
# Local Dev:  redis://localhost:6379/0
# Docker:     redis://redis:6379/0
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0


# -----------------------------------------------------------------------------
# 5. QDRANT — Vector Database [REQUIRED in production]
# Production: Use your Qdrant Cloud cluster URL + API key
# Local Dev:  http://localhost:6333
# Docker:     http://qdrant:6333
# -----------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=


# -----------------------------------------------------------------------------
# 6. FRONTEND URL — [REQUIRED in production]
# Production: https://your-app.vercel.app
# Local Dev:  http://localhost:3000
# Used for CORS policy and email verification/reset links.
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000

# Extra CORS origins (comma-separated) — e.g. staging preview URLs
ADDITIONAL_CORS_ORIGINS=


# -----------------------------------------------------------------------------
# 7. GOOGLE OAUTH — [REQUIRED for Google Sign-In]
# Create credentials at: https://console.cloud.google.com/apis/credentials
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# 8. GEMINI AI — [REQUIRED for AI features]
# Get your API key at: https://aistudio.google.com/app/apikey
# Required for: transcription summaries, keyword extraction, embeddings, chat.
# -----------------------------------------------------------------------------
GEMINI_API_KEY=


# -----------------------------------------------------------------------------
# 9. CLOUDINARY — File Storage [REQUIRED in production]
# Production: STORAGE_PROVIDER must be "cloudinary"
# Local Dev:  STORAGE_PROVIDER=local is acceptable
# Get credentials at: https://cloudinary.com/console
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Local upload directory (only used when STORAGE_PROVIDER=local)
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=52428800


# -----------------------------------------------------------------------------
# 10. SMTP EMAIL — [Required for email verification & password reset]
# Leave SMTP_USER and SMTP_PASSWORD blank to run in simulated log-only mode.
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER="Briefen <noreply@briefen.ai>"

# Set to true to skip email verification (dev/Docker only — NEVER in production)
SKIP_EMAIL_VERIFICATION=false


# -----------------------------------------------------------------------------
# 11. WHISPER — Speech-to-Text Model
# Options: tiny | base | small | medium | large
# Smaller models start faster; larger models are more accurate.
# Recommendation for Render: tiny (fastest cold start) or base.
# -----------------------------------------------------------------------------
WHISPER_MODEL_SIZE=base


# -----------------------------------------------------------------------------
# 12. CELERY WORKER
# Concurrency for Celery worker processes (used in Dockerfile.worker).
# -----------------------------------------------------------------------------
CELERY_CONCURRENCY=2
